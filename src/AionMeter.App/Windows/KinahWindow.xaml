<Window x:Class="AionMeter.App.Windows.KinahWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:AionMeter.App.Services"
        Title="{Binding KinahLabel, Source={x:Static s:UiText.Current}}" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}" FontSize="12.5"
        ToolTip="{Binding KinahTip, Source={x:Static s:UiText.Current}}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <!-- DaevaTrack: Kinah balances, up whenever economy tracking is on -->
    <Border Background="{StaticResource Bg0}" BorderBrush="{StaticResource GoldDim}" BorderThickness="1" CornerRadius="8"
            Padding="12,8" MinWidth="210" Opacity="0.92">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding KinahLabel, Source={x:Static s:UiText.Current}}" Foreground="{StaticResource TextDim}"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="KinahAmount" Grid.Column="1" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Gold}"
                       HorizontalAlignment="Right" Margin="14,0,0,0" />
            <TextBlock x:Name="KinahChange" Grid.Column="2" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center" />

            <TextBlock Grid.Row="1" Text="{Binding BoundKinahLabel, Source={x:Static s:UiText.Current}}" Foreground="{StaticResource TextDim}"
                       VerticalAlignment="Center" Margin="0,4,0,0" />
            <TextBlock x:Name="BoundAmount" Grid.Row="1" Grid.Column="1" FontSize="14" FontWeight="SemiBold"
                       HorizontalAlignment="Right" Margin="14,4,0,0" />
            <TextBlock x:Name="BoundChange" Grid.Row="1" Grid.Column="2" FontSize="11.5" Margin="8,4,0,0" VerticalAlignment="Center" />
        </Grid>
    </Border>
</Window>
